# Copy to .env next to docker-compose.example.yml (or your real compose
# file) and fill in the two secrets. This file is the switcher's own
# configuration. It is NOT the VPN stack's .env. STACK_DIR points at that
# other folder.
#
# Never commit the filled-in .env. It is gitignored.

# bcrypt hash from:  python -m app.hash_password
# Paste the PASSWORD_HASH= line the command prints. In a Compose env file
# every $ in the hash must be written as $$, or Compose will delete pieces
# of it. The command prints the line already escaped.
PASSWORD_HASH=replace-with-output-of-hash-password

# At least 16 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=replace-with-a-long-random-string

# Absolute path of the VPN compose project, on the host. Mount that same
# path into this container. See the README.
STACK_DIR=/path/to/vpn-stack

# --- optional, defaults shown ---
# ENV_FILE=.env
# COMPOSE_FILE=
# VPN_SERVICE=gluetun
# VPN_CONTAINER=
# DEPENDENT_SERVICES=
# COUNTRY_ENV=VPN_SERVER_COUNTRIES
# CITY_ENV=VPN_SERVER_CITIES
# CONTAINER_COUNTRY_ENV=SERVER_COUNTRIES
# CONTAINER_CITY_ENV=SERVER_CITIES
# LOCATION_REGIONS=Europe
# AIRVPN_STATUS_URL=https://airvpn.org/api/status/
# LOCATION_CACHE_SECONDS=300
# GLUETUN_PROXY_URL=
# IP_INFO_URL=https://ipinfo.io/json
# COMPOSE_TIMEOUT_SECONDS=180
# HEALTH_TIMEOUT_SECONDS=120
# HEALTH_POLL_SECONDS=2
# IP_CHECK_TIMEOUT_SECONDS=20
# LOCATION_FETCH_TIMEOUT=15
# SECURE_COOKIE=false
# SESSION_MAX_AGE_SECONDS=604800
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=600
# HOST=0.0.0.0
# PORT=8080
